@online{dias2016ComputingObservablesCurved,
  title = {Computing Observables in Curved Multifield Models of Inflation - {{A}} Guide (with Code) to the Transport Method},
  author = {Dias, Mafalda and Frazer, Jonathan and Seery, David},
  date = {2016-01-19},
  eprint = {1502.03125},
  eprinttype = {arXiv},
  eprintclass = {astro-ph},
  doi = {10.48550/arXiv.1502.03125},
  url = {http://arxiv.org/abs/1502.03125},
  urldate = {2025-02-18},
  abstract = {We describe how to apply the transport method to compute inflationary observables in a broad range of multiple-field models. The method is efficient and encompasses scenarios with curved field-space metrics, violations of slow-roll conditions and turns of the trajectory in field space. It can be used for an arbitrary mass spectrum, including massive modes and models with quasi-single-field dynamics. In this note we focus on practical issues. It is accompanied by a Mathematica code which can be used to explore suitable models, or as a basis for further development.},
  pubstate = {prepublished},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics,High Energy Physics - Theory},
  file = {/Users/flaviopineda/Documents/Zotero/Dias et al_2016_Computing observables in curved multifield models of inflation - A guide (with.pdf;/Users/flaviopineda/Zotero/storage/UUVF8PDI/1502.html}
}

