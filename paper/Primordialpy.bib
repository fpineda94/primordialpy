@online{mulryne2017PyTransportPythonPackage,
  title = {{{PyTransport}}: {{A Python}} Package for the Calculation of Inflationary Correlation Functions},
  shorttitle = {{{PyTransport}}},
  author = {Mulryne, David J. and Ronayne, John W.},
  date = {2017-08-24},
  eprint = {1609.00381},
  eprinttype = {arXiv},
  eprintclass = {astro-ph},
  doi = {10.48550/arXiv.1609.00381},
  url = {http://arxiv.org/abs/1609.00381},
  urldate = {2025-02-18},
  abstract = {PyTransport constitutes a straightforward code written in C++ together with Python scripts which automatically edit, compile and run the C++ code as a Python module. It has been written for Unix-like systems (OS X and Linux). Primarily the module employs the transport approach to inflationary cosmology to calculate the tree-level power-spectrum and bispectrum of user specified models of multi-field inflation, accounting for all sub and super-horizon effects. The transport method we utilise means only coupled differential equations need to be solved, and the implementation presented here combines the speed of C++ with the functionality and convenience of Python. This document details the code and illustrates how to use it with a worked example. It has been updated to be a companion to the second version of the code, PyTransport 2.0, which includes functionality to deal with models of inflation with a curved field space metric.},
  pubstate = {prepublished},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics,High Energy Physics - Theory},
  file = {/Users/flaviopineda/Documents/Zotero/Mulryne_Ronayne_2017_PyTransport.pdf;/Users/flaviopineda/Zotero/storage/NQHIU674/1609.html}
}

